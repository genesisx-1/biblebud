# Bible Bro - Environment Variables
# Copy this file to .env and fill in your actual values

# Supabase Configuration
# Get these from your Supabase project settings (https://app.supabase.com)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Note: The service role key should NEVER be exposed in the client app
# It's only used in Supabase Edge Functions
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here (DO NOT PUT IN CLIENT .env)

# OpenAI API Key
# This should ONLY be set in your Supabase Edge Function environment
# Get your key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key-here (DO NOT PUT IN CLIENT .env)

# Development
# Set this to true to enable development mode features
DEV_MODE=false
